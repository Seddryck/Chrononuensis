namespace Chrononuensis.Extensions;

public static partial class {{struct_name}}Extension
{
    {{- for part in parts -}}
    {{- part_index = for.index -}}
    {{- if !part.variable }}
    {{- if part.min && part.max }}
    {{- if parts.size ==1 && part.name == struct_name }}{{name = "Value"}}{{ else }}{{ name = part.name }}{{ end }}
    public static {{ struct_name }} Add{{ part.name }}(this {{ struct_name }} value, int {{ part.name | string.downcase }})
    {
        var normalized = CyclicArithmetic.Normalize(
            value.{{ name }}, {{ part.name | string.downcase }}, {{ part.min }}, {{ part.max }}, out var cycles);

        return new {{ struct_name }}(
            {{- for constructor_part in parts }}
            {{- if for.index == part_index }}normalized
            {{- else if for.index < part_index }}value.{{ constructor_part.name }} + cycles
            {{- else }}value.{{ constructor_part.name }}
            {{- end }}
            {{- if !for.last }}, {{ end }}
            {{- end }});
    }
    {{- else if !part.min }}
    {{- if parts.size > 1 }}
    public static {{ struct_name }} Add{{ part.name }}(this {{ struct_name }} value, int {{ part.name | string.downcase }})
        => new {{ struct_name }}(
            {{- for constructor_part in parts }}
            {{- if for.index == part_index }}value.{{ constructor_part.name }} + {{ part.name | string.downcase }}
            {{- else }}value.{{ constructor_part.name }}
            {{- end }}
            {{- if !for.last }}, {{ end }}
            {{- end }});
    {{- else }}
    public static {{ struct_name }} Add{{ part.name }}(this {{ struct_name }} value, int {{ part.name | string.downcase }})
        => new(value.Value + {{ part.name | string.downcase }}{{ if part.modulo }} * {{ part.modulo }}{{ end }});
    {{- end }}
    {{- end }}
    {{- end }}
    {{- end }}
}
